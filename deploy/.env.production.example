# Plantilla de .env para producción. Cópiala a /var/www/seocrawler/.env
# y rellénala. Nunca la subas a un repositorio.

# --- Base de datos ---------------------------------------------------------
# Usuario propio, NUNCA root: en un VPS compartido root ve y puede borrar las
# bases de los demás proyectos. Escapa los caracteres raros de la contraseña
# (@ -> %40, # -> %23, etc.).
DATABASE_URL="mysql://seocrawler:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/seocrawler"

# --- Seguridad -------------------------------------------------------------
# Genérala con:  openssl rand -base64 48
#
# Firma la cookie de sesión Y cifra los secretos guardados en la base (clave
# de Serplify, de DeepSeek, credenciales de Google, contraseña SMTP). Si la
# cambias, esos secretos dejan de poder descifrarse y hay que volver a
# introducirlos uno por uno. Haz copia de seguridad de este valor.
AUTH_SECRET=""

# URL pública con https. La usan los enlaces de los correos (invitaciones,
# recuperación de contraseña) y el retorno del OAuth de Google.
NEXTAUTH_URL="https://seo.tudominio.com"

# --- Crawler ---------------------------------------------------------------
CRAWLER_USER_AGENT="SeoCrawlerBot/1.0 (+https://seo.tudominio.com)"
# Bájala si el VPS es pequeño o si comparte CPU con otros proyectos.
CRAWLER_MAX_CONCURRENCY="5"
CRAWLER_TIMEOUT_MS="15000"
CRAWLER_MAX_REDIRECTS="10"
CRAWLER_MAX_HTML_BYTES="5242880"

# Déjalo en false. En true el crawler podría alcanzar servicios internos del
# VPS (bases de datos, paneles de otros proyectos, metadatos del proveedor):
# es justo lo que la protección contra SSRF impide.
CRAWLER_ALLOW_PRIVATE_HOSTS="false"

# --- Worker ----------------------------------------------------------------
WORKER_POLL_MS="2000"
WORKER_ID="vps-1"

# Cada cuánto se persiste el avance de un crawl. Ver README, sección
# "Escrituras sobre la fila del crawl".
CRAWL_PROGRESS_WRITE_MS="1000"

# --- Tracking de keywords --------------------------------------------------
# Hora UTC desde la que arranca el tracking diario. Elige una de madrugada
# para tu zona.
TRACKING_HOUR="3"
TRACKING_BATCH_SIZE="500"
TRACKING_BATCH_DELAY_MS="250"
GSC_LAG_DAYS="3"

# Pausa entre consultas de posiciones a Serplify.
SERP_DELAY_MS="400"
SERPLIFY_SEARCH_TIMEOUT_MS="45000"
SERPLIFY_TIMEOUT_MS="20000"

# --- Opcionales ------------------------------------------------------------
# SMTP, Google OAuth y Serplify se configuran mejor desde el panel de
# administración, que los guarda cifrados en la base. Estas variables sólo
# actúan como valor inicial.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# La clave de IA es de cada cuenta y se pone desde Ajustes, no aquí.
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
